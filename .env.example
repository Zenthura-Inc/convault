# Optional: canonical public site URL for metadata, robots.txt, and sitemap.xml.
# Defaults to https://convault.app when unset.
# Use HTTPS for deployed sites; HTTP is accepted only for localhost development.
SITE_URL=

# Optional: shared rate-limit store for production upload/API abuse protection.
# Leave unset for local development; the app will use a bounded in-memory fallback.
# URL must be an HTTPS Redis REST endpoint, such as an Upstash REST URL.
# Do not include credentials in the URL; use RATE_LIMIT_REDIS_REST_TOKEN instead.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
